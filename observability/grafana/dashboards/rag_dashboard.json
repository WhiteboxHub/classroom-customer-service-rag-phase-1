{
    "__inputs": [],
    "__requires": [
        {
            "type": "grafana",
            "id": "grafana",
            "name": "Grafana",
            "version": "10.0.0"
        },
        {
            "type": "datasource",
            "id": "prometheus",
            "name": "Prometheus",
            "version": "1.0.0"
        },
        {
            "type": "panel",
            "id": "timeseries",
            "name": "Time series",
            "version": ""
        },
        {
            "type": "panel",
            "id": "stat",
            "name": "Stat",
            "version": ""
        }
    ],
    "annotations": {
        "list": []
    },
    "description": "RAG Phase 1 - Request Latency, Chunk Counts, and Error Rates",
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 0,
    "id": null,
    "links": [],
    "panels": [
        {
            "id": 1,
            "title": "Total RAG Requests",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 0,
                "y": 0
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "sum(rag_requests_total)",
                    "legendFormat": "Total Requests",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "steps": [
                            {
                                "color": "green",
                                "value": 0
                            }
                        ]
                    },
                    "unit": "short"
                }
            }
        },
        {
            "id": 2,
            "title": "Request Rate (req/min)",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 6,
                "y": 0
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "sum(rate(rag_requests_total[5m])) * 60",
                    "legendFormat": "req/min",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "steps": [
                            {
                                "color": "green",
                                "value": 0
                            },
                            {
                                "color": "yellow",
                                "value": 10
                            },
                            {
                                "color": "red",
                                "value": 50
                            }
                        ]
                    }
                }
            }
        },
        {
            "id": 3,
            "title": "Active Requests",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 12,
                "y": 0
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "rag_active_requests",
                    "legendFormat": "Active",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "steps": [
                            {
                                "color": "green",
                                "value": 0
                            },
                            {
                                "color": "red",
                                "value": 10
                            }
                        ]
                    }
                }
            }
        },
        {
            "id": 4,
            "title": "Empty Retrievals",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 18,
                "y": 0
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "sum(rag_retrieval_empty_total)",
                    "legendFormat": "Empty Retrievals",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "steps": [
                            {
                                "color": "green",
                                "value": 0
                            },
                            {
                                "color": "yellow",
                                "value": 5
                            },
                            {
                                "color": "red",
                                "value": 20
                            }
                        ]
                    }
                }
            }
        },
        {
            "id": 5,
            "title": "End-to-End Latency (p50 / p95 / p99)",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 4
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.50, sum(rate(rag_latency_seconds_bucket{phase=\"total\"}[5m])) by (le))",
                    "legendFormat": "p50",
                    "refId": "A"
                },
                {
                    "expr": "histogram_quantile(0.95, sum(rate(rag_latency_seconds_bucket{phase=\"total\"}[5m])) by (le))",
                    "legendFormat": "p95",
                    "refId": "B"
                },
                {
                    "expr": "histogram_quantile(0.99, sum(rate(rag_latency_seconds_bucket{phase=\"total\"}[5m])) by (le))",
                    "legendFormat": "p99",
                    "refId": "C"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s"
                }
            }
        },
        {
            "id": 6,
            "title": "Latency by Phase (embed / retrieve / llm)",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 4
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.50, sum(rate(rag_latency_seconds_bucket{phase=\"embed\"}[5m])) by (le))",
                    "legendFormat": "embed p50",
                    "refId": "A"
                },
                {
                    "expr": "histogram_quantile(0.50, sum(rate(rag_latency_seconds_bucket{phase=\"retrieve\"}[5m])) by (le))",
                    "legendFormat": "retrieve p50",
                    "refId": "B"
                },
                {
                    "expr": "histogram_quantile(0.50, sum(rate(rag_latency_seconds_bucket{phase=\"llm\"}[5m])) by (le))",
                    "legendFormat": "llm p50",
                    "refId": "C"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s"
                }
            }
        },
        {
            "id": 7,
            "title": "Retrieved Chunks per Query",
            "type": "timeseries",
            "gridPos": {
                "h": 7,
                "w": 12,
                "x": 0,
                "y": 12
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.50, sum(rate(rag_retrieved_chunks_bucket[5m])) by (le))",
                    "legendFormat": "median chunks",
                    "refId": "A"
                },
                {
                    "expr": "histogram_quantile(0.95, sum(rate(rag_retrieved_chunks_bucket[5m])) by (le))",
                    "legendFormat": "p95 chunks",
                    "refId": "B"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short"
                }
            }
        },
        {
            "id": 8,
            "title": "Requests by Status (success/error)",
            "type": "timeseries",
            "gridPos": {
                "h": 7,
                "w": 12,
                "x": 12,
                "y": 12
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "sum(rate(rag_requests_total{status=\"success\"}[5m]))",
                    "legendFormat": "success/s",
                    "refId": "A"
                },
                {
                    "expr": "sum(rate(rag_requests_total{status=\"error\"}[5m]))",
                    "legendFormat": "error/s",
                    "refId": "B"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps"
                }
            }
        }
    ],
    "schemaVersion": 38,
    "tags": [
        "rag",
        "monitoring",
        "phase1"
    ],
    "title": "RAG Phase 1 - System Overview",
    "uid": "rag-phase1-overview",
    "version": 1
}